---
const navItems = ["Signals", "Members", "Automations", "Data"];

const metrics = [
  { label: "Active workspaces", value: "128", delta: "+18%" },
  { label: "Member events", value: "42.6k", delta: "+9%" },
  { label: "Automation runs", value: "7,304", delta: "99.8%" },
];

const signals = [
  {
    label: "Member segment",
    value: "Trial accounts crossing activation threshold",
    status: "Live",
  },
  {
    label: "Data trigger",
    value: "Usage spike syncs into the retention queue",
    status: "Queued",
  },
  {
    label: "Workflow",
    value: "Onboarding nudge waits for profile completion",
    status: "Ready",
  },
];

const modules = [
  "Wix-managed headless shell",
  "Astro server-rendered surfaces",
  "SDK-ready data layer",
  "Member and workflow patterns",
];

const timeline = [
  "Capture usage event",
  "Match member profile",
  "Route to account queue",
  "Trigger next best action",
];
---

<div class="app-shell">
  <aside class="sidebar" aria-label="Pulse Labs navigation">
    <a class="brand" href="/" aria-label="Pulse Labs home">
      <span class="brand-pulse"></span>
      <span>Pulse Labs</span>
    </a>
    <nav>
      {
        navItems.map((item) => (
          <a href={`#${item.toLowerCase()}`}>{item}</a>
        ))
      }
    </nav>
    <div class="sidebar-note">
      <span>Headless mode</span>
      <strong>Astro + Wix</strong>
      <small>Powered by Wix Headless. Built with wix-headless.dev.</small>
    </div>
  </aside>

  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span>Live product surface</span>
          <strong>09:41 UTC</strong>
        </div>
        <p class="eyebrow">SaaS showcase</p>
        <h1 id="page-title">A launch room for data, members, and workflow signals.</h1>
        <p>
          Pulse Labs turns the Wix Headless Astro starter into a product-facing
          SaaS surface: metric panels, member states, event queues, and
          automation-ready copy shaped for a custom front end.
        </p>
        <div class="hero-actions" aria-label="Pulse Labs actions">
          <a href="#signals" class="primary-link">View signal board</a>
          <a href="#data" class="secondary-link">Inspect stack</a>
        </div>
      </div>

      <section class="metrics-panel" id="members" aria-label="Operating metrics">
        <div class="panel-header">
          <span>Today</span>
          <strong>Operations pulse</strong>
        </div>
        <div class="metric-grid">
          {
            metrics.map((metric) => (
              <article>
                <p>{metric.label}</p>
                <strong>{metric.value}</strong>
                <span>{metric.delta}</span>
              </article>
            ))
          }
        </div>
        <div class="health-strip" aria-label="System health">
          <span></span>
          <span></span>
          <span></span>
          <strong>All connectors healthy</strong>
        </div>
      </section>
    </section>

    <section class="command-grid">
      <article class="signal-board" id="signals">
        <div class="section-heading">
          <p class="eyebrow">Signal board</p>
          <h2>Member activity becomes product motion.</h2>
        </div>
        <div class="signal-list">
          {
            signals.map((signal) => (
              <div class="signal-row">
                <div>
                  <span>{signal.label}</span>
                  <strong>{signal.value}</strong>
                </div>
                <em>{signal.status}</em>
              </div>
            ))
          }
        </div>
      </article>

      <article class="automation-card" id="automations">
        <p class="eyebrow">Automation path</p>
        <h2>Capture event, qualify account, send the next action.</h2>
        <div class="flow" aria-label="Automation sequence">
          {
            timeline.map((item) => (
              <span>{item}</span>
            ))
          }
        </div>
      </article>
    </section>

    <section class="data-ops" aria-label="Data operations preview">
      <div class="ops-window">
        <div class="window-bar">
          <span></span>
          <span></span>
          <span></span>
          <strong>members.sync</strong>
        </div>
        <code>
          <span>event.created</span>
          <strong>usage_spike</strong>
          <em>matched to 382 accounts</em>
        </code>
        <code>
          <span>segment.updated</span>
          <strong>activation_risk</strong>
          <em>queued for follow-up</em>
        </code>
        <code>
          <span>workflow.ready</span>
          <strong>nudge_sequence</strong>
          <em>waiting on profile state</em>
        </code>
      </div>
      <div class="ops-copy">
        <p class="eyebrow">Wix Headless capability</p>
        <h2>Keep Wix operational, make the product interface unmistakably yours.</h2>
        <p>
          The site demonstrates how a SaaS team can build dense internal or
          customer-facing tools on a headless foundation without inheriting a
          generic dashboard aesthetic.
        </p>
      </div>
    </section>

    <section class="foundation" id="data" aria-label="Headless foundation">
      <div>
        <p class="eyebrow">Foundation</p>
        <h2>Built to show how a SaaS team could own the interface.</h2>
      </div>
      <div class="module-grid">
        {
          modules.map((module) => (
            <article>
              <span></span>
              <p>{module}</p>
            </article>
          ))
        }
      </div>
    </section>
    <footer class="site-credit">
      <span>Powered by Wix Headless | Built with <a href="https://www.wix-headless.dev" target="_blank" rel="noreferrer">wix-headless.dev</a></span>
      <a class="github-icon-link" href="https://github.com/wix-incubator/pulselabs" target="_blank" rel="noreferrer" aria-label="View source on GitHub" title="View source on GitHub">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.79 8.21 11.38.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22 0 1.61-.02 2.9-.02 3.3 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z" />
        </svg>
      </a>
    </footer>
  </main>
</div>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #edf3ea;
    color: #11130f;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .app-shell {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 17.5rem minmax(0, 1fr);
    background:
      linear-gradient(rgba(17, 19, 15, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 15, 0.05) 1px, transparent 1px),
      linear-gradient(135deg, #edf3ea, #f8fbf5 55%, #e9eef8);
    background-size: 32px 32px, 32px 32px, auto;
  }

  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100svh;
    flex-direction: column;
    border-right: 1px solid #bac8b3;
    background: rgba(250, 252, 247, 0.9);
    padding: 1.1rem;
    backdrop-filter: blur(18px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.01em;
  }

  .brand-pulse {
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid #11130f;
    background:
      linear-gradient(135deg, transparent 43%, #11130f 44% 55%, transparent 56%),
      linear-gradient(90deg, #c7f45d 0 50%, #2b6ff6 50% 100%);
    box-shadow: 5px 5px 0 #11130f;
  }

  nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 2.7rem;
  }

  nav a {
    border: 1px solid transparent;
    padding: 0.75rem 0.85rem;
    color: #4a5147;
    font-size: 0.9rem;
    font-weight: 720;
  }

  nav a:hover {
    border-color: #11130f;
    background: #fff;
    color: #11130f;
  }

  .sidebar-note {
    margin-top: auto;
    border: 1px solid #11130f;
    background: #11130f;
    color: #f8fff0;
    padding: 1rem;
    box-shadow: 5px 5px 0 #c7f45d;
  }

  .sidebar-note span,
  .eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sidebar-note strong {
    display: block;
    margin-top: 0.4rem;
    color: #c7f45d;
  }

  .sidebar-note small {
    display: block;
    margin-top: 0.9rem;
    color: rgba(248, 255, 240, 0.68);
    line-height: 1.5;
  }

  main {
    width: min(100%, 1320px);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
    gap: clamp(1rem, 3vw, 2rem);
    min-height: calc(100svh - clamp(2rem, 6vw, 4rem));
    align-items: stretch;
  }

  .hero-copy,
  .metrics-panel,
  .signal-board,
  .automation-card,
  .foundation,
  .data-ops {
    border: 1px solid #11130f;
    background: rgba(255, 255, 255, 0.86);
  }

  .hero-copy {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 5vw, 4.25rem);
    background:
      linear-gradient(135deg, rgba(199, 244, 93, 0.42), transparent 32%),
      linear-gradient(315deg, rgba(43, 111, 246, 0.12), transparent 40%),
      linear-gradient(180deg, #ffffff, #f8fbf5);
  }

  .hero-copy::after {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1rem, 4vw, 3rem);
    width: min(34vw, 24rem);
    height: 0.7rem;
    content: "";
    background: linear-gradient(90deg, #c7f45d, #2b6ff6, #e64b35);
  }

  .hero-kicker {
    position: absolute;
    top: clamp(1rem, 3vw, 1.5rem);
    right: clamp(1rem, 3vw, 1.5rem);
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    border: 1px solid #11130f;
    background: #fff;
    padding: 0.55rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 850;
  }

  .hero-kicker span {
    color: #566151;
  }

  .eyebrow {
    margin: 0;
    color: #e64b35;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 13ch;
    margin: 0.8rem 0 1.25rem;
    font-size: clamp(3.45rem, 8.5vw, 8.45rem);
    font-weight: 880;
    line-height: 0.86;
    letter-spacing: 0;
  }

  .hero-copy p:not(.eyebrow) {
    max-width: 45rem;
    margin-bottom: 0;
    color: #4c5548;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-bottom: 1.5rem;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid #11130f;
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    font-weight: 850;
  }

  .primary-link {
    background: #11130f;
    color: #f8fff0;
    box-shadow: 5px 5px 0 #c7f45d;
  }

  .secondary-link {
    background: #fff;
    color: #11130f;
  }

  .metrics-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: #11130f;
    color: #f8fff0;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(248, 255, 240, 0.18);
    padding-bottom: 1rem;
  }

  .panel-header span {
    color: #c7f45d;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .metric-grid {
    display: grid;
    gap: 0.75rem;
  }

  .metric-grid article {
    border: 1px solid rgba(248, 255, 240, 0.18);
    background:
      linear-gradient(90deg, rgba(199, 244, 93, 0.08), transparent),
      rgba(248, 255, 240, 0.06);
    padding: clamp(1rem, 3vw, 1.35rem);
  }

  .metric-grid p {
    margin-bottom: 1.35rem;
    color: #ccd8c2;
    font-size: 0.88rem;
  }

  .metric-grid strong {
    display: block;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.9;
  }

  .metric-grid span {
    display: inline-block;
    margin-top: 0.8rem;
    color: #c7f45d;
    font-weight: 800;
  }

  .health-strip {
    display: grid;
    grid-template-columns: auto auto auto 1fr;
    gap: 0.45rem;
    align-items: center;
    border-top: 1px solid rgba(248, 255, 240, 0.18);
    padding-top: 1rem;
    color: rgba(248, 255, 240, 0.72);
    font-size: 0.82rem;
  }

  .health-strip span {
    width: 0.55rem;
    height: 0.55rem;
    background: #c7f45d;
  }

  .command-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .signal-board,
  .automation-card,
  .foundation,
  .data-ops {
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .section-heading h2,
  .automation-card h2,
  .foundation h2,
  .ops-copy h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 870;
    line-height: 0.94;
  }

  .signal-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .signal-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid #11130f;
    background: #f8fbf5;
    padding: 1rem;
  }

  .signal-row span {
    color: #6a7465;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .signal-row strong {
    display: block;
    margin-top: 0.45rem;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1.15;
  }

  .signal-row em {
    border: 1px solid #11130f;
    background: #c7f45d;
    padding: 0.4rem 0.55rem;
    color: #11130f;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 850;
  }

  .automation-card {
    background:
      linear-gradient(135deg, #11130f, #1d2435);
    color: #f8fff0;
  }

  .automation-card .eyebrow {
    color: #c7f45d;
  }

  .flow {
    display: grid;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .flow span {
    border: 1px solid rgba(248, 255, 240, 0.24);
    background: rgba(248, 255, 240, 0.08);
    padding: 0.85rem;
    color: #f8fff0;
    font-size: 0.88rem;
    font-weight: 850;
  }

  .data-ops {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1rem, 4vw, 2.5rem);
    margin-top: clamp(1rem, 3vw, 2rem);
    background: #ffffff;
  }

  .ops-window {
    border: 1px solid #11130f;
    background: #11130f;
    color: #f8fff0;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid rgba(248, 255, 240, 0.18);
    padding: 0.8rem;
  }

  .window-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #c7f45d;
  }

  .window-bar span:nth-child(2) {
    background: #2b6ff6;
  }

  .window-bar span:nth-child(3) {
    background: #e64b35;
  }

  .window-bar strong {
    margin-left: auto;
    color: rgba(248, 255, 240, 0.68);
    font-size: 0.8rem;
  }

  code {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 0.7rem;
    border-bottom: 1px solid rgba(248, 255, 240, 0.12);
    padding: 1rem;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.82rem;
  }

  code span {
    color: #c7f45d;
  }

  code em {
    color: rgba(248, 255, 240, 0.6);
    font-style: normal;
  }

  .ops-copy {
    align-self: center;
  }

  .ops-copy p:not(.eyebrow) {
    color: #4c5548;
    line-height: 1.7;
  }

  .foundation {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
    background: #f8fbf5;
  }

  .module-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .module-grid article {
    display: grid;
    min-height: 10rem;
    align-content: space-between;
    border: 1px solid #11130f;
    background: #fff;
    padding: 1rem;
  }

  .module-grid span {
    width: 2rem;
    height: 0.5rem;
    background: linear-gradient(90deg, #c7f45d, #2b6ff6);
  }

  .site-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1rem, 3vw, 2rem);
    border: 1px solid #11130f;
    background: #fff;
    padding: 1rem;
    color: #4c5548;
    font-size: 0.88rem;
    font-weight: 850;
  }

  .site-credit a {
    color: #2b6ff6;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .site-credit .github-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid #11130f;
    background: #fff;
    color: #11130f;
    text-decoration: none;
    box-shadow: 4px 4px 0 #c7f45d;
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .site-credit .github-icon-link:hover {
    background: #2b6ff6;
    color: #fff;
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #c7f45d;
  }

  .site-credit .github-icon-link svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  .module-grid p {
    margin-bottom: 0;
    font-weight: 820;
    line-height: 1.25;
  }

  @media (max-width: 1080px) {
    .app-shell {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid #bac8b3;
    }

    nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 1.2rem;
    }

    .sidebar-note {
      margin-top: 1.2rem;
    }
  }

  @media (max-width: 860px) {
    .hero,
    .command-grid,
    .foundation,
    .data-ops {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .hero-kicker {
      position: static;
      width: fit-content;
      margin-bottom: 1.5rem;
    }

    .hero-copy::after {
      display: none;
    }
  }

  @media (max-width: 620px) {
    nav,
    .module-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 5rem);
    }

    code {
      grid-template-columns: 1fr;
    }
  }
</style>
