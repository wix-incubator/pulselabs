---
const navItems = ["Signals", "Members", "Automations", "Data"];

const metrics = [
  { label: "Active workspaces", value: "128", delta: "+18%" },
  { label: "Member events", value: "42.6k", delta: "+9%" },
  { label: "Automation runs", value: "7,304", delta: "99.8%" },
];

const signals = [
  {
    label: "Member segment",
    value: "Trial accounts crossing activation threshold",
    status: "Live",
  },
  {
    label: "Data trigger",
    value: "Usage spike syncs into the retention queue",
    status: "Queued",
  },
  {
    label: "Workflow",
    value: "Onboarding nudge waits for profile completion",
    status: "Ready",
  },
];

const modules = [
  "Wix-managed headless shell",
  "Astro server-rendered surfaces",
  "SDK-ready data layer",
  "Member and workflow patterns",
];
---

<div class="app-shell">
  <aside class="sidebar" aria-label="Pulse Labs navigation">
    <a class="brand" href="/" aria-label="Pulse Labs home">
      <span class="brand-pulse"></span>
      <span>Pulse Labs</span>
    </a>
    <nav>
      {
        navItems.map((item) => (
          <a href={`#${item.toLowerCase()}`}>{item}</a>
        ))
      }
    </nav>
    <div class="sidebar-note">
      <span>Headless mode</span>
      <strong>Astro + Wix</strong>
    </div>
  </aside>

  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow">SaaS showcase</p>
        <h1 id="page-title">A launch room for data, members, and workflow signals.</h1>
        <p>
          Pulse Labs turns the Wix Headless Astro starter into a product-facing
          SaaS surface: metric panels, member states, event queues, and
          automation-ready copy shaped for a custom front end.
        </p>
      </div>

      <section class="metrics-panel" id="members" aria-label="Operating metrics">
        <div class="panel-header">
          <span>Today</span>
          <strong>Operations pulse</strong>
        </div>
        <div class="metric-grid">
          {
            metrics.map((metric) => (
              <article>
                <p>{metric.label}</p>
                <strong>{metric.value}</strong>
                <span>{metric.delta}</span>
              </article>
            ))
          }
        </div>
      </section>
    </section>

    <section class="command-grid">
      <article class="signal-board" id="signals">
        <div class="section-heading">
          <p class="eyebrow">Signal board</p>
          <h2>Member activity becomes product motion.</h2>
        </div>
        <div class="signal-list">
          {
            signals.map((signal) => (
              <div class="signal-row">
                <div>
                  <span>{signal.label}</span>
                  <strong>{signal.value}</strong>
                </div>
                <em>{signal.status}</em>
              </div>
            ))
          }
        </div>
      </article>

      <article class="automation-card" id="automations">
        <p class="eyebrow">Automation path</p>
        <h2>Capture event, qualify account, send the next action.</h2>
        <div class="flow" aria-label="Automation sequence">
          <span>Event</span>
          <span>Rule</span>
          <span>Member</span>
          <span>Action</span>
        </div>
      </article>
    </section>

    <section class="foundation" id="data" aria-label="Headless foundation">
      <div>
        <p class="eyebrow">Foundation</p>
        <h2>Built to show how a SaaS team could own the interface.</h2>
      </div>
      <div class="module-grid">
        {
          modules.map((module) => (
            <article>
              <span></span>
              <p>{module}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</div>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #eef3ea;
    color: #11130f;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .app-shell {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    background:
      linear-gradient(rgba(17, 19, 15, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 15, 0.05) 1px, transparent 1px),
      #eef3ea;
    background-size: 32px 32px;
  }

  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100svh;
    flex-direction: column;
    border-right: 1px solid #c6d1c0;
    background: rgba(250, 252, 247, 0.9);
    padding: 1.1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.01em;
  }

  .brand-pulse {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #11130f;
    background:
      linear-gradient(135deg, transparent 44%, #11130f 45% 55%, transparent 56%),
      #c7f45d;
  }

  nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 2.5rem;
  }

  nav a {
    border: 1px solid transparent;
    padding: 0.75rem 0.85rem;
    color: #4a5147;
    font-size: 0.9rem;
    font-weight: 720;
  }

  nav a:hover {
    border-color: #11130f;
    background: #fff;
    color: #11130f;
  }

  .sidebar-note {
    margin-top: auto;
    border: 1px solid #11130f;
    background: #11130f;
    color: #f8fff0;
    padding: 1rem;
  }

  .sidebar-note span,
  .eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sidebar-note strong {
    display: block;
    margin-top: 0.4rem;
    color: #c7f45d;
  }

  main {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: clamp(1rem, 3vw, 2rem);
    min-height: calc(100svh - clamp(2rem, 6vw, 4rem));
    align-items: stretch;
  }

  .hero-copy,
  .metrics-panel,
  .signal-board,
  .automation-card,
  .foundation {
    border: 1px solid #11130f;
    background: rgba(255, 255, 255, 0.84);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 5vw, 4rem);
    background:
      linear-gradient(135deg, rgba(199, 244, 93, 0.36), transparent 34%),
      linear-gradient(180deg, #ffffff, #f8fbf5);
  }

  .eyebrow {
    margin: 0;
    color: #e64b35;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 13ch;
    margin: 0.8rem 0 1.25rem;
    font-size: clamp(3.5rem, 8.5vw, 8.25rem);
    font-weight: 880;
    line-height: 0.86;
    letter-spacing: 0;
  }

  .hero-copy p:last-child {
    max-width: 45rem;
    margin-bottom: 0;
    color: #4c5548;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.7;
  }

  .metrics-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: #11130f;
    color: #f8fff0;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(248, 255, 240, 0.18);
    padding-bottom: 1rem;
  }

  .panel-header span {
    color: #c7f45d;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .metric-grid {
    display: grid;
    gap: 0.75rem;
  }

  .metric-grid article {
    border: 1px solid rgba(248, 255, 240, 0.18);
    background: rgba(248, 255, 240, 0.06);
    padding: clamp(1rem, 3vw, 1.35rem);
  }

  .metric-grid p {
    margin-bottom: 1.35rem;
    color: #ccd8c2;
    font-size: 0.88rem;
  }

  .metric-grid strong {
    display: block;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.9;
  }

  .metric-grid span {
    display: inline-block;
    margin-top: 0.8rem;
    color: #c7f45d;
    font-weight: 800;
  }

  .command-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .signal-board,
  .automation-card,
  .foundation {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .section-heading h2,
  .automation-card h2,
  .foundation h2 {
    margin: 0.65rem 0 0;
    font-size: clamp(2rem, 4vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .signal-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .signal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #c6d1c0;
    background: #f8fbf5;
    padding: 1rem;
  }

  .signal-row span {
    display: block;
    color: #66705e;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .signal-row strong {
    display: block;
    margin-top: 0.35rem;
    line-height: 1.35;
  }

  .signal-row em {
    border: 1px solid #11130f;
    background: #c7f45d;
    padding: 0.35rem 0.5rem;
    color: #11130f;
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 850;
    text-transform: uppercase;
  }

  .automation-card {
    background: #fff;
  }

  .flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(2rem, 6vw, 4.5rem);
  }

  .flow span {
    display: grid;
    min-height: 6rem;
    place-items: center;
    border: 1px solid #11130f;
    background: #11b5ad;
    color: #06211f;
    font-weight: 900;
  }

  .flow span:nth-child(2) {
    background: #f8d66d;
  }

  .flow span:nth-child(3) {
    background: #ffffff;
  }

  .flow span:nth-child(4) {
    background: #e64b35;
    color: #fff;
  }

  .foundation {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(300px, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .module-grid {
    display: grid;
    gap: 0.75rem;
  }

  .module-grid article {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid #c6d1c0;
    background: #f8fbf5;
    padding: 1rem;
  }

  .module-grid span {
    width: 0.85rem;
    height: 0.85rem;
    background: #e64b35;
  }

  .module-grid p {
    margin-bottom: 0;
    font-weight: 760;
  }

  @media (max-width: 980px) {
    .app-shell {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid #c6d1c0;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .sidebar-note {
      display: none;
    }

    .hero,
    .command-grid,
    .foundation {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    main {
      padding: 0.75rem;
    }

    .flow {
      grid-template-columns: 1fr;
    }

    .signal-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
